# 复制为 .env 后按环境填写。不要把真实密钥提交到版本库。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 默认离线摘录；使用 API 时改为 api 并填写自己的 Key。
TUNNEL_QA_MODEL_MODE=local
TUNNEL_QA_LOCAL_PROVIDER=builtin
TUNNEL_QA_DATABASE_URL=sqlite:///./data/tunnel_qa.db
TUNNEL_QA_ORIGINAL_CONTENT_DATABASE_URL=sqlite:///./data/original_documents.db
TUNNEL_QA_CHUNK_CONTENT_DATABASE_URL=sqlite:///./data/document_chunks.db
TUNNEL_QA_STORAGE_PATH=./data/storage
TUNNEL_QA_ENVIRONMENT=development
# 公网部署时设置为 production，并启用整站访问密码。
TUNNEL_QA_PUBLIC_ACCESS_ENABLED=false
TUNNEL_QA_PUBLIC_ACCESS_USERNAME=tunnel-admin
TUNNEL_QA_PUBLIC_ACCESS_PASSWORD=
# 首次启用公网登录必须自行设置强密码；已有账号在账号管理页修改。
# ngrok 域名通过启动脚本 -Domain 参数或进程环境变量提供，不写入代码。
